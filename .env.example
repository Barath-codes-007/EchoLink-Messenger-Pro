# ==========================================================================
# EchoLink Messenger — environment configuration
# Copy this file to `.env` in the /server folder (or project root, either
# works since server.js loads dotenv from its own directory first) and fill
# in real values before deploying anywhere public.
# ==========================================================================

# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Auth
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_NAME=echolink_token
REFRESH_COOKIE_NAME=echolink_refresh

# Database (SQLite file path, relative to /server)
DB_PATH=./data/echolink.db

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# SVG uploads are disabled by default (an SVG can embed <script>/event
# handlers and isn't safe to serve back inline without a real sanitizer).
# Only set this to 1 if you've added SVG sanitization downstream.
ALLOW_SVG_UPLOADS=0

# Rooms
MAX_TEMP_ROOM_SIZE=12
MAX_PERMANENT_ROOM_SIZE=200
MAX_MESSAGE_LENGTH=4000
ROOM_EXPIRY_SWEEP_MS=15000

# WebRTC (STUN is free/public; for calls to work reliably across strict NATs
# and corporate firewalls you should add a TURN server, e.g. self-hosted
# coturn or a paid provider like Twilio/Xirsys, and list it here)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# GIF picker (optional). Get a free key at https://developers.google.com/tenor
# Leave blank and the GIF picker will show a clear "not configured" message
# instead of silently failing.
TENOR_API_KEY=
